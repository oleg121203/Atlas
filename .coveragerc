# Coverage configuration for Atlas AI Assistant
[run]
branch = True
source = core,ui,tools,utils,atlas
omit =
    */tests/*
    */__pycache__/*
    */.*
    */venv/*
    */.venv/*
    */env/*
    */build/*
    */dist/*
    */.tox/*
    */node_modules/*
    */backup_ui/*
    */backup_ui_qt/*

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code:
    def __repr__
    if self\.debug

    # Don't complain if tests don't hit defensive assertion code:
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run:
    if 0:
    if __name__ == .__main__.:

    # Don't complain about abstract methods, they aren't run:
    @(abc\.)?abstractmethod

    # Don't complain about TYPE_CHECKING imports
    if TYPE_CHECKING:

ignore_errors = True
show_missing = True
precision = 2
skip_covered = False
skip_empty = True

[html]
directory = htmlcov
show_contexts = True

[xml]
output = coverage.xml
